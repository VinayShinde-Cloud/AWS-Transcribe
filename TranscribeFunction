import json
import logging
import boto3
import os
import re
from urllib.parse import unquote_plus
from botocore.exceptions import ClientError

logger = logging.getLogger()
logger.setLevel(logging.INFO)
transcribe = boto3.client('transcribe')

def lambda_handler(event, context):
    out_prefix = os.environ.get('OUTPUT_PREFIX', 'output/results/')
    in_prefix = os.environ.get('INPUT_PREFIX', 'input/')
    supported = ['mp4', 'mp3', 'wav', 'flac', 'ogg', 'amr', 'webm']
    
    for record in event.get('Records', []):
        try:
            bucket = record['s3']['bucket']['name']
            key = unquote_plus(record['s3']['object']['key'])
            
            if not key.startswith(in_prefix):
                continue
            
            ext_split = key.split('.')
            if len(ext_split) < 2: continue
            file_ext = ext_split[-1].lower()
            
            if file_ext not in supported:
                continue

            filename = os.path.basename(key)
            clean_name = re.sub(r'[^a-zA-Z0-9._-]', '-', filename)
            job_name = f"job_{clean_name[:150]}" 

            try:
                transcribe.start_transcription_job(
                    TranscriptionJobName=job_name,
                    Media={'MediaFileUri': f's3://{bucket}/{key}'},
                    MediaFormat=file_ext,
                    IdentifyLanguage=True,
                    OutputBucketName=bucket,
                    OutputKey=f"{out_prefix}{job_name}.json"
                )
                logger.info(f"Success: {job_name}")
            except ClientError as e:
                if e.response['Error']['Code'] == 'ConflictException':
                    logger.info(f"Skip: {job_name}")
                else:
                    raise e
        except Exception as e:
            logger.error(f"Error: {str(e)}", exc_info=True)
            continue
    return {"Status": "Complete"}
